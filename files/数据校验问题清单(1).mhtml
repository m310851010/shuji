		else{
			if (g_rglTabX[c_lTabs] > offsetWidth + scrollLeft){
				for (i =3D 0; i < c_lTabs && g_rglTabX[i] <=3D scrollLeft; ++i);
				if (i < c_lTabs)
					iNextTab=3Di;
			}
		}
	}
	return iNextTab;
}
