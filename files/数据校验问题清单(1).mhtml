function fnNextTab(fDir)
{
	var iNextTab =3D -1;
	var i;
	with (frames['frTabs'].document.body){
		if (fDir =3D=3D 0){
			if (scrollLeft > 0){
				for (i =3D 0; i < c_lTabs && g_rglTabX[i] < scrollLeft; ++i);
				if ( i < c_lTabs)
					iNextTab =3D i - 1;
			}
